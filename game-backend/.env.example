# ─── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Public origin of the WordPress site / game. CORS is locked to this value.
# In production this MUST be https://domain.com (no trailing slash).
CORS_ORIGIN=http://localhost:8080

# ─── MySQL (Hostinger remote) ───────────────────────────────────────────────
DB_HOST=srv1359.hstgr.io
DB_PORT=3306
DB_NAME=u796782613_game_db
DB_USER=u796782613_game_user
DB_PASSWORD=CHANGE_ME

# Pool tuning
DB_CONNECTION_LIMIT=10

# ─── JWT: Node-issued access token ──────────────────────────────────────────
# 32+ random chars. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_access_secret
JWT_ACCESS_EXPIRY=15m

# ─── Refresh token (opaque, stored hashed in DB; delivered as httpOnly cookie)
JWT_REFRESH_EXPIRY_DAYS=7
REFRESH_COOKIE_NAME=game_rt
# Seconds a just-rotated refresh token is still tolerated, to survive a client
# that never received the rotated value (network drop). 0 disables the grace.
REFRESH_ROTATION_GRACE_SECONDS=60

# ─── WordPress handoff token (shared secret with Plugin 2) ──────────────────
# This MUST be byte-for-byte identical to the value shown on the WordPress
# "Game Handoff" plugin settings page (wp_option: game_handoff_secret).
HANDOFF_SECRET=CHANGE_ME_shared_with_wordpress
# Max age (seconds) a handoff token is accepted for, independent of its own exp.
HANDOFF_MAX_AGE_SECONDS=60
# Expected issuer claim in the handoff token (set the same in the WP plugin).
HANDOFF_ISSUER=wordpress

# ─── Cookie flags ────────────────────────────────────────────────────────────
# In production set COOKIE_SECURE=true (requires HTTPS). Keep false for local http.
COOKIE_SECURE=false
# SameSite for the refresh cookie: strict is fine when game + API share a site.
COOKIE_SAMESITE=Strict
